{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "P06A REVIEW ONLY: transactional token-only DynamoDB journal, disabled dedicated Lambda worker, independent GitHub monitor/dead-man. No activation authorized.",
  "Parameters": {
    "VercelOidcProviderArn": {
      "Type": "String",
      "MinLength": 1
    },
    "GithubOidcProviderArn": {
      "Type": "String",
      "MinLength": 1
    },
    "AlarmEmail": {
      "Type": "String",
      "MinLength": 1
    },
    "JournalName": {
      "Type": "String",
      "AllowedPattern": "trackdash-erasure-[a-z0-9-]{1,100}"
    }
  },
  "Resources": {
    "Journal": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": {
          "Ref": "JournalName"
        },
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true,
          "RecoveryPeriodInDays": 35
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "state",
            "AttributeType": "S"
          },
          {
            "AttributeName": "createdAt",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "pending",
            "KeySchema": [
              {
                "AttributeName": "state",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "createdAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ]
      }
    },
    "IngressRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "VercelOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "oidc.vercel.com/mercseba-8773:aud": "https://vercel.com/mercseba-8773",
                  "oidc.vercel.com/mercseba-8773:sub": "owner:mercseba-8773:project:trackdash:environment:production"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ErasureScoped",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:PutItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "r#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "r#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "_meta"
                      ]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": [
                        "pk",
                        "accepted"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ErasureScoped",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:Scan",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:Query",
                  "Resource": {
                    "Fn::Sub": "${Journal.Arn}/index/pending"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "r#*"
                      ]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": [
                        "pk",
                        "state"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:UpdateItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "_meta"
                      ]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": [
                        "pk",
                        "completed"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${WorkerLog.Arn}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sns:Publish",
                  "Resource": {
                    "Ref": "Alarms"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "MonitorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GithubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:mercseba-afk/trackdash:environment:p06a-monitor"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ErasureScoped",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "cloudwatch:PutMetricData",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "cloudwatch:namespace": "TrackDash/Erasure"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Journal",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "_meta"
                      ]
                    },
                    "ForAllValues:StringEquals": {
                      "dynamodb:Attributes": [
                        "pk",
                        "accepted",
                        "completed"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:Query",
                  "Resource": {
                    "Fn::Sub": "${Journal.Arn}/index/pending"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Timeout": 60,
        "MemorySize": 512,
        "ReservedConcurrentExecutions": 1,
        "Code": {
          "ZipFile": "exports.handler=async()=>{throw new Error(\"REVIEWED_ARTIFACT_NOT_UPLOADED\")};"
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "WorkerLog"
          }
        },
        "Environment": {
          "Variables": {
            "EBAY_ERASURE_RUNNER_ENABLED": "false",
            "EBAY_ERASURE_JOURNAL_REGION": {
              "Ref": "AWS::Region"
            },
            "EBAY_ERASURE_JOURNAL_TABLE": {
              "Ref": "Journal"
            },
            "EBAY_ERASURE_ALARM_TOPIC_ARN": {
              "Ref": "Alarms"
            }
          }
        }
      }
    },
    "NoLambdaRetries": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "Qualifier": "approved",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      },
      "DependsOn": "ApprovedAlias"
    },
    "Tick": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(5 minutes)",
        "State": "DISABLED",
        "Targets": [
          {
            "Id": "ErasureWorker",
            "Arn": {
              "Ref": "ApprovedAlias"
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 0,
              "MaximumEventAgeInSeconds": 60
            }
          }
        ]
      }
    },
    "TickPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApprovedAlias"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "Tick",
            "Arn"
          ]
        }
      }
    },
    "Alarms": {
      "Type": "AWS::SNS::Topic"
    },
    "Recipient": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlarmEmail"
        },
        "TopicArn": {
          "Ref": "Alarms"
        }
      }
    },
    "WorkerMissing": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Invocations",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "ComparisonOperator": "LessThanThreshold",
        "Threshold": 1,
        "TreatMissingData": "breaching",
        "ActionsEnabled": false,
        "AlarmActions": [
          {
            "Ref": "Alarms"
          }
        ],
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ]
      }
    },
    "WorkerFailed": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 0,
        "TreatMissingData": "notBreaching",
        "ActionsEnabled": false,
        "AlarmActions": [
          {
            "Ref": "Alarms"
          }
        ],
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Worker"
            }
          }
        ]
      }
    },
    "MonitorMissingOrFailed": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "TrackDash/Erasure",
        "MetricName": "MonitorSuccess",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "ComparisonOperator": "LessThanThreshold",
        "Threshold": 1,
        "TreatMissingData": "breaching",
        "ActionsEnabled": false,
        "AlarmActions": [
          {
            "Ref": "Alarms"
          }
        ]
      }
    },
    "InitialVersion": {
      "Type": "AWS::Lambda::Version",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "Description": "Disabled bootstrap only; replace alias with reviewed artifact version after approval"
      }
    },
    "ApprovedAlias": {
      "Type": "AWS::Lambda::Alias",
      "Properties": {
        "Name": "approved",
        "FunctionName": {
          "Ref": "Worker"
        },
        "FunctionVersion": {
          "Fn::GetAtt": [
            "InitialVersion",
            "Version"
          ]
        }
      }
    }
  },
  "Outputs": {
    "IngressRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "IngressRole",
          "Arn"
        ]
      }
    },
    "MonitorRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "MonitorRole",
          "Arn"
        ]
      }
    },
    "JournalTable": {
      "Value": {
        "Ref": "Journal"
      }
    },
    "WorkerFunction": {
      "Value": {
        "Ref": "Worker"
      }
    },
    "WorkerAlias": {
      "Value": {
        "Ref": "ApprovedAlias"
      }
    }
  }
}
