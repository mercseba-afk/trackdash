{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm verify && next build",
    "start": "next start",
    "verify": "pnpm typecheck && pnpm catalog:check && pnpm images:check && pnpm images:parity && pnpm images:test && pnpm market:pipeline:test && pnpm market:runner:test && pnpm market:edge:test && pnpm market:r3:test && pnpm market:method:test && pnpm market:public:test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:generate": "node --experimental-strip-types scripts/generate-catalog-seed.mjs > supabase/migrations/0003_seed_initial_catalog.sql",
    "db:seed:images:generate": "node --experimental-strip-types scripts/seed-images.mjs > supabase/migrations/0008_seed_catalog_images.sql",
    "db:normalize:generate": "node --experimental-strip-types scripts/generate-catalog-normalization.mjs > supabase/migrations/0007_catalog_normalization.sql",
    "catalog:check": "node --experimental-strip-types scripts/run-catalog-check.mjs",
    "images:check": "node --experimental-strip-types scripts/check-images.mjs",
    "images:parity": "node --experimental-strip-types scripts/check-demo-image-parity.mjs",
    "images:test": "node --experimental-strip-types scripts/test-image-resolver.mjs",
    "market:pipeline:test": "node --experimental-strip-types scripts/test-market-pipeline.mjs",
    "market:runner:test": "node --experimental-strip-types scripts/test-market-runner.mjs",
    "market:edge:test": "node --experimental-strip-types scripts/test-market-edge-cases.mjs",
    "market:r3:test": "node --experimental-strip-types scripts/test-market-r3.mjs",
    "market:method:test": "node --experimental-strip-types scripts/test-market-method-v1.mjs",
    "market:public:test": "node scripts/test-market-public-surfaces.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
