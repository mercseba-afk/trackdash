# Supabase -- copy this file to .env.local and fill in real values from your
# Supabase project settings. Never commit .env.local (it's already covered
# by the .env*.local rule in .gitignore).
#
# Full step-by-step setup procedure (creating the project, applying
# migrations, provisioning the app-runtime role, running the two-user RLS
# test): see docs/SUPABASE_SETUP.md.

# Public -- safe to expose to the browser. Used by lib/supabase/client.ts,
# lib/supabase/server.ts and lib/supabase/proxy.ts.
# Find both under Project Settings > API Keys.
#
# Supabase key naming: projects now issue a "publishable" key
# (sb_publishable_...) alongside/instead of the legacy "anon" key
# (a long JWT). Either works here unchanged -- this app just passes
# whatever string you put here straight to the Supabase client, which
# accepts both formats identically, and RLS behaves the same either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only elevated key for trusted backend jobs such as Price Intelligence.
# NEVER prefix these with NEXT_PUBLIC_ and never expose them to browser code.
# Supabase currently recommends the newer sb_secret_* key where available.
# TrackDash keeps the legacy service_role variable as a compatibility fallback.
# lib/supabase/admin.ts prefers SUPABASE_SECRET_KEY and falls back to
# SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only -- direct Postgres connection string for Drizzle, used by the
# APPLICATION AT RUNTIME (lib/db/index.ts). Different from the API keys above:
# this is a raw Postgres connection.
#
# This should connect as the restricted `trackdash_app` role (created by
# migration 0004_app_runtime_role.sql), NOT the default Supabase "postgres"
# role -- connecting as "postgres" silently bypasses every RLS policy in
# this project (see lib/db/rls.ts and that migration for the full explanation).
#
# Format: postgresql://trackdash_app:<password-you-set>@<host>:<port>/postgres
DATABASE_URL=

# Server-only -- privileged Postgres connection, used ONLY by drizzle-kit
# (drizzle.config.ts) to run migrations (CREATE TABLE, CREATE ROLE, GRANT,
# ...) -- never imported by application code. Use the connection string
# Supabase gives you by default (Project Settings > Database > Connection
# string; the pooled "Transaction" string works for this too), i.e. the
# `postgres` role. If unset, drizzle-kit falls back to DATABASE_URL, which
# is only correct BEFORE migration 0004 has run (when DATABASE_URL is
# still the privileged connection too) -- set this explicitly once the
# restricted role exists.
MIGRATION_DATABASE_URL=
