# Supabase — copy this file to .env.local and fill in real values from your
# Supabase project settings (Project Settings > API). Never commit .env.local
# (it's already covered by the .env*.local rule in .gitignore).

# Public — safe to expose to the browser. Used by lib/supabase/client.ts,
# lib/supabase/server.ts and lib/supabase/proxy.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
# Reserved for future server-side/admin operations (e.g. catalog import
# scripts) that need to bypass Row Level Security. Not used yet.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — direct Postgres connection string for Drizzle (Step 2).
# Different from the two vars above: those talk to the Supabase API, this
# is a raw Postgres connection. Find it in Supabase > Project Settings >
# Database > Connection string (use the pooled "Transaction" connection
# string for serverless/Next.js deployments).
DATABASE_URL=
